/* =====================================================
   QUIZLAND ADVENTURE
   STYLE.CSS
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Fredoka',sans-serif;
}

body{
    background:linear-gradient(135deg,#8fd3ff,#b7f7ff,#fff8b5);
    min-height:100vh;
    overflow-x:hidden;
    scrollbar-width:thin;
    scrollbar-color:#5bb8ff #e8f6ff;
}

/* =====================================================
   CUSTOM SCROLLBAR (kid-friendly)
===================================================== */

*::-webkit-scrollbar{
    width:14px;
    height:14px;
}

*::-webkit-scrollbar-track{
    background:linear-gradient(180deg,#eaf7ff 0%,#fff8dc 100%);
    border-radius:999px;
    border:3px solid transparent;
    background-clip:padding-box;
    box-shadow:inset 0 0 0 1px rgba(58,134,255,.12);
}

*::-webkit-scrollbar-thumb{
    background:linear-gradient(180deg,#7ad0ff 0%,#4aa8ff 45%,#ffb703 100%);
    border-radius:999px;
    border:3px solid transparent;
    background-clip:padding-box;
    box-shadow:
        0 2px 8px rgba(58,134,255,.28),
        inset 0 1px 0 rgba(255,255,255,.55);
    min-height:48px;
}

*::-webkit-scrollbar-thumb:hover{
    background:linear-gradient(180deg,#9adcff 0%,#3a86ff 50%,#ff9f1c 100%);
    background-clip:padding-box;
    box-shadow:
        0 4px 12px rgba(58,134,255,.38),
        inset 0 1px 0 rgba(255,255,255,.7);
}

*::-webkit-scrollbar-thumb:active{
    background:linear-gradient(180deg,#3a86ff 0%,#2667d1 55%,#fb8500 100%);
    background-clip:padding-box;
}

*::-webkit-scrollbar-corner{
    background:transparent;
}

*::-webkit-scrollbar-button{
    display:none;
    width:0;
    height:0;
}

/* Softer scroll areas inside white panels */
.quiz-container,
.settings-panel,
.modal-content,
.tdash,
.quiz-history-table-wrap,
.teacher-progress-table,
.bar-chart{
    scrollbar-width:thin;
    scrollbar-color:#4aa8ff #eef7ff;
}

.quiz-container::-webkit-scrollbar-track,
.settings-panel::-webkit-scrollbar-track,
.modal-content::-webkit-scrollbar-track{
    background:linear-gradient(180deg,#f2f9ff,#fff6e8);
    border-radius:999px;
}

.quiz-container::-webkit-scrollbar-thumb,
.settings-panel::-webkit-scrollbar-thumb,
.modal-content::-webkit-scrollbar-thumb{
    background:linear-gradient(180deg,#6bc4ff,#3a86ff 55%,#ffb703);
    background-clip:padding-box;
}

/* =====================================================
   SCREENS
===================================================== */

.screen{
    display:none;
    min-height:100vh;
    justify-content:center;
    align-items:center;
    padding:24px;
}

.screen.active{
    display:flex;
}

/* =====================================================
   HOME
===================================================== */

.home-container{
    width:100%;
    max-width:650px;
    text-align:center;
}



h1{
    font-size:52px;
    color:#ff6b6b;
    margin-bottom:10px;
}

.subtitle{
    font-size:22px;
    color:#555;
    margin-bottom:25px;
}



/* =====================================================
   BUTTONS
===================================================== */

.button-group{
    display:flex;
    flex-direction:column;
    gap:20px;
}

.main-btn{

    width:100%;
    padding:18px;

    border:none;
    border-radius:18px;

    background:#ffb703;
    color:white;

    font-size:22px;
    font-weight:bold;

    cursor:pointer;

    transition:.3s;
}

#teacherSubmitBtn{
    background:#2ecc71;
}

#teacherSubmitBtn:hover{
    background:#27ae60;
}

.main-btn:hover{

    transform:translateY(-5px);

    background:#fb8500;

    box-shadow:0 10px 25px rgba(0,0,0,.20);
}

.main-btn i{

    margin-right:10px;
}

/* =====================================================
   PROFILE
===================================================== */

.profile-container{

    width:100%;
    max-width:700px;

    background:white;

    border-radius:30px;

    padding:40px;

    text-align:center;

    box-shadow:0 20px 45px rgba(0,0,0,.15);
}

.teacher-container{

    width:100%;
    max-width:700px;
    text-align:center;
}

.teacher-card{

    background:rgba(255,255,255,0.95);
    border-radius:30px;
    padding:40px;
    box-shadow:0 25px 50px rgba(0,0,0,.15);
    border:1px solid rgba(58, 134, 255, 0.15);
}

.teacher-card h2{
    color:#1d3557;
    margin-bottom:10px;
}

.teacher-card p{
    color:#556680;
    margin-bottom:25px;
    font-size:18px;
}

.teacher-form{
    display:flex;
    flex-direction:column;
    gap:18px;
}

.teacher-form-actions{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.input-wrapper{
    position:relative;
    width:100%;
}

.input-wrapper input{
    width:100%;
    padding:18px 60px 18px 18px;
    border-radius:16px;
    border:2px solid #d8e9ff;
    font-size:18px;
    outline:none;
    transition:all 0.3s ease;
}

.password-toggle-btn{
    position:absolute;
    right:12px;
    top:50%;
    transform:translateY(-50%);
    border:none;
    background:transparent;
    color:#2463eb;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
    padding:6px 8px;
    border-radius:8px;
    z-index:2;
}

.password-toggle-btn:hover{
    background:rgba(36, 99, 235, 0.08);
}

.input-wrapper input:focus{
    border-color:#3a86ff;
    box-shadow:0 0 0 3px rgba(58, 134, 255, 0.1);
}

.input-error-icon{
    position:absolute;
    right:16px;
    top:50%;
    transform:translateY(-50%);
    color:#e63946;
    font-size:20px;
    display:none;
    pointer-events:none;
}

.input-error-message{
    position:absolute;
    top:50%;
    left:18px;
    transform:translateY(-50%);
    background:linear-gradient(135deg, #e63946, #d62828);
    color:white;
    padding:6px 12px;
    border-radius:8px;
    font-size:14px;
    font-weight:600;
    white-space:nowrap;
    opacity:0;
    pointer-events:none;
    transition:opacity 0.3s ease;
    z-index:10;
    box-shadow:0 4px 12px rgba(230, 57, 70, 0.3);
}

.input-wrapper.error input{
    border-color:#e63946;
    background-color:rgba(230, 57, 70, 0.05);
}

.input-wrapper.error .input-error-icon{
    display:block;
}

.input-wrapper.error .input-error-message{
    opacity:1;
    left:18px;
}

.teacher-form input{
    width:100%;
    padding:18px;
    border-radius:16px;
    border:2px solid #d8e9ff;
    font-size:18px;
    outline:none;
}

.teacher-hidden{
    display:none !important;
}

.teacher-switch{
    display:flex;
    flex-direction:column;
    align-items:stretch;
    gap:10px;
    margin:0;
}

.teacher-switch span{
    color:#556680;
    font-size:16px;
    text-align:center;
}

.secondary-btn{
    width:100%;
    padding:14px 18px;
    border:none;
    border-radius:16px;
    background:#eaf3ff;
    color:#1d3557;
    font-size:18px;
    font-weight:700;
    cursor:pointer;
    transition:all 0.25s ease;
}

.secondary-btn:hover{
    background:#dfeeff;
    transform:translateY(-2px);
}

.teacher-form .back-btn{
    margin-top:4px;
}

.teacher-form--unlock{
    gap:20px;
}

.teacher-form--unlock #teacherSubmitBtn{
    margin-top:4px;
}

.teacher-form--unlock .back-btn{
    margin-top:8px;
}

.teacher-progress-panel{
    margin-top:30px;
    text-align:left;
}

/* =====================================================
   TEACHER DASHBOARD (ENHANCED)
===================================================== */

#teacherDashboard.screen.active{
    align-items:flex-start;
    padding:28px 20px 48px;
}

.tdash{
    width:100%;
    max-width:1180px;
    margin:0 auto;
    display:flex;
    flex-direction:column;
    gap:22px;
}

.tdash-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:20px;
    padding:28px 30px;
    border-radius:28px;
    background:
        linear-gradient(135deg,rgba(255,255,255,.96),rgba(255,255,255,.88)),
        linear-gradient(145deg,#dff4ff,#fff4c4);
    box-shadow:0 18px 40px rgba(29,53,87,.12);
    border:1px solid rgba(255,255,255,.7);
}

.tdash-eyebrow{
    margin:0 0 6px;
    font-size:13px;
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:#3a86ff;
}

.tdash-header h2{
    margin:0 0 8px;
    color:#1d3557;
    font-size:34px;
    text-align:left;
}

.tdash-welcome{
    margin:0;
    color:#556680;
    font-size:17px;
}

.tdash-header-actions{
    display:flex;
    gap:10px;
    flex-shrink:0;
}

.tdash-btn{
    border:none;
    border-radius:14px;
    padding:12px 18px;
    font-family:inherit;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    transition:transform .2s ease, box-shadow .2s ease, filter .2s ease;
}

.tdash-btn:hover{
    transform:translateY(-2px);
}

.tdash-btn--ghost{
    background:rgba(255,255,255,.85);
    color:#1d3557;
    box-shadow:0 6px 16px rgba(29,53,87,.08);
}

.tdash-btn--refresh{
    background:rgba(76,201,240,.16);
    color:#0b6e99;
    box-shadow:0 6px 16px rgba(76,201,240,.18);
}

.tdash-btn--solid{
    background:linear-gradient(135deg,#ffb703,#ff8a4c);
    color:#fff;
    box-shadow:0 8px 18px rgba(255,183,3,.3);
}

.tdash-btn--soft{
    background:rgba(58,134,255,.12);
    color:#1d4f9c;
}

.tdash-btn--danger{
    background:rgba(230,57,70,.12);
    color:#c1121f;
}

.tdash-panel{
    padding:24px;
    border-radius:24px;
    background:rgba(255,255,255,.94);
    box-shadow:0 14px 34px rgba(29,53,87,.1);
    border:1px solid rgba(255,255,255,.75);
    text-align:left;
}

.tdash-charts{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:22px;
}

.tdash-panel--wide{
    width:100%;
}

.tdash-panel-head{
    margin-bottom:18px;
}

.tdash-panel-head h3{
    margin:0 0 4px;
    color:#1d3557;
    font-size:22px;
}

.tdash-panel-head p{
    margin:0;
    color:#6b7c90;
    font-size:14px;
}

.bar-chart{
    display:flex;
    align-items:flex-end;
    justify-content:flex-start;
    gap:14px;
    min-height:220px;
    padding:18px 8px 8px;
    overflow-x:auto;
    border-radius:18px;
    background:linear-gradient(180deg,#f7fbff 0%,#eef6ff 100%);
}

.bar-chart--daily{
    min-height:260px;
}

.bar-chart--daily .bar-item{
    flex:0 0 72px;
}

.bar-name--date{
    font-size:11px;
    white-space:normal;
    text-align:center;
    line-height:1.2;
    max-width:72px;
}

.teacher-needs-interpretation{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.teacher-needs-summary{
    margin:0;
    color:#1d3557;
    font-size:15px;
    font-weight:600;
    line-height:1.6;
}

.teacher-needs-list{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
    gap:12px;
}

.teacher-needs-item{
    background:linear-gradient(135deg, rgba(255, 196, 0, 0.08), rgba(58, 134, 255, 0.08));
    border:1px solid rgba(255, 166, 0, 0.18);
    border-radius:18px;
    padding:14px 16px;
}

.teacher-needs-name{
    display:inline-block;
    margin-bottom:4px;
    padding:6px 10px;
    border-radius:10px;
    background:linear-gradient(135deg,#ffb703,#ff8a4c);
    color:#fff;
    font-weight:900;
    letter-spacing:0.02em;
    box-shadow:0 6px 16px rgba(255,140,0,.2);
}

.teacher-needs-meta,
.teacher-needs-note{
    color:#53657b;
    font-size:13px;
    line-height:1.5;
}

.teacher-needs-note{
    margin-top:4px;
    color:#b25b00;
    font-weight:600;
}

.teacher-needs-empty{
    padding:18px 16px;
    border-radius:16px;
    background:rgba(58,134,255,.06);
    border:1px dashed rgba(58,134,255,.24);
    color:#53657b;
    font-size:14px;
}

.bar-chart-empty{
    width:100%;
    min-height:180px;
    display:grid;
    place-items:center;
    color:#7a8aa0;
    font-size:15px;
    text-align:center;
    padding:20px;
}

.bar-item{
    flex:0 0 64px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:8px;
    min-height:180px;
    justify-content:flex-end;
}

.bar-value-label{
    font-size:12px;
    font-weight:700;
    color:#1d3557;
}

.bar-track-vertical{
    width:100%;
    height:150px;
    display:flex;
    align-items:flex-end;
    justify-content:center;
    border-radius:14px 14px 8px 8px;
    background:rgba(255,255,255,.7);
    overflow:hidden;
}

.bar-fill-vertical{
    width:78%;
    border-radius:12px 12px 6px 6px;
    background:linear-gradient(180deg,#4cc9f0,#3a86ff);
    min-height:4px;
    transition:height .55s cubic-bezier(.2,.9,.25,1);
    box-shadow:0 8px 16px rgba(58,134,255,.25);
}

.bar-fill-vertical.is-stars{
    background:linear-gradient(180deg,#ffe566,#ffb703);
    box-shadow:0 8px 16px rgba(255,183,3,.28);
}

.bar-fill-vertical.is-daily{
    background:linear-gradient(180deg,#80ed99,#2ecc71);
    box-shadow:0 8px 16px rgba(46,204,113,.28);
}

.bar-name{
    font-size:12px;
    font-weight:600;
    color:#556680;
    text-align:center;
    max-width:64px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.teacher-progress-table,
.quiz-history-table-wrap{
    overflow-x:auto;
    border-radius:18px;
    background:#f7fbff;
    padding:12px;
}

#teacherStudentProgressTable,
#teacherQuizHistoryTable{
    width:100%;
    border-collapse:collapse;
    min-width:640px;
}

#teacherStudentProgressTable th,
#teacherStudentProgressTable td,
#teacherQuizHistoryTable th,
#teacherQuizHistoryTable td{
    padding:14px 16px;
    border-bottom:1px solid rgba(29,53,87,.08);
    color:#2a3a5b;
    font-size:15px;
    text-align:left;
}

#teacherStudentProgressTable th,
#teacherQuizHistoryTable th{
    font-weight:700;
    background:rgba(255,255,255,.9);
    color:#1d3557;
}

#teacherStudentProgressTable tbody tr:hover,
#teacherQuizHistoryTable tbody tr:hover{
    background:rgba(255,255,255,.95);
}

#teacherQuizHistoryTable tbody tr.is-latest{
    background:linear-gradient(90deg,rgba(255,214,10,.26),rgba(255,244,190,.58));
    box-shadow:inset 5px 0 0 #ffb703;
}

#teacherQuizHistoryTable tbody tr.is-latest:hover{
    background:linear-gradient(90deg,rgba(255,214,10,.34),rgba(255,244,190,.72));
}

.latest-history-badge{
    display:inline-block;
    margin-left:8px;
    padding:3px 8px;
    border-radius:999px;
    background:#ffb703;
    color:#5e3c00;
    font-size:11px;
    font-weight:800;
    text-transform:uppercase;
    vertical-align:middle;
}

#teacherStudentProgressTable tr.is-selected{
    background:rgba(141,211,255,.22);
}

.student-avatar-cell{
    width:40px;
    height:40px;
    border-radius:50%;
    object-fit:cover;
    display:block;
}

.latest-activity-cell{
    background:linear-gradient(135deg,rgba(255,214,10,.32),rgba(255,183,3,.12));
    color:#8a5700 !important;
    font-weight:700;
    white-space:nowrap;
}

.latest-activity-cell strong,
.latest-activity-cell span{
    display:block;
}

.latest-activity-cell span{
    margin-top:3px;
    color:#9a6b19;
    font-size:12px;
    font-weight:600;
}

.tdash-row-actions{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
}

.quiz-history-empty td{
    text-align:center !important;
    color:#7a8aa0;
    padding:28px 16px !important;
}

.teacher-toggle-btn:hover,
.link-btn:hover,
.back-btn:hover{
    background:#5845d4;
}

.teacher-stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:18px;
    margin:30px 0;
}

.stat-card{
    background:#f1f7ff;
    border-radius:22px;
    padding:24px;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
}

.stat-number{
    font-size:44px;
    font-weight:800;
    color:#3a86ff;
    margin-bottom:10px;
}

@media(max-width:900px){
    .tdash-charts{
        grid-template-columns:1fr;
    }

    .tdash-header{
        flex-direction:column;
    }
}

@media(max-width:560px){
    .tdash-header h2{
        font-size:28px;
    }
}

.profile-container h2{

    color:#ff6b6b;

    margin-bottom:10px;
}

.profile-container p{

    color:#777;

    margin-bottom:25px;
}

#studentName{

    width:100%;

    padding:18px;

    border-radius:15px;

    border:3px solid #8ecae6;

    font-size:20px;

    margin-bottom:30px;

    outline:none;
}

.avatar-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(120px,1fr));

    gap:20px;

    margin-bottom:30px;
}

.avatar-card{

    background:#f4fbff;

    border-radius:20px;

    padding:15px;

    cursor:pointer;

    transition:.3s;

    border:4px solid transparent;
}

.avatar-card:hover{

    transform:scale(1.05);

    border-color:#ffb703;
}

.avatar-card img{

    width:90px;

    height:90px;

    object-fit:contain;
}

/* =====================================================
   LEARNING MENU
===================================================== */

.menu-container{

    width:100%;

    max-width:1000px;

    margin:0 auto;

    text-align:center;
}

.menu-container h2{

    color:#ff6b6b;

    margin-bottom:40px;

    font-size:38px;
}

.lesson-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));

    gap:24px;
}

.lesson-card{

    background:white;

    border-radius:25px;

    padding:20px;

    box-shadow:0 15px 30px rgba(0,0,0,.15);

    transition:.3s;
}

.lesson-card img{

    width:100%;

    max-height:220px;

    object-fit:cover;

    border-radius:20px;

    margin-bottom:20px;
}

.lesson-card:hover{

    transform:translateY(-10px);
}

    .lesson-feedback{

        margin:6px auto 10px;

        display:flex;
        flex-direction:column;
        align-items:center;
        justify-content:center;

        font-size:clamp(16px, 2.4vh, 20px);

        color:#555;

        max-width:700px;

        line-height:1.35;

        text-align:center;

        flex-shrink:0;

    }

    .lesson-info{
        display:block;
        margin-bottom:10px;
        font-size:18px;
        color:#777;
    }

    .lesson-speech{
        display:block;
        font-size:26px;
        font-weight:600;
        color:#3a86ff;
    }


.lesson-card h3{

    color:#444;

    margin-bottom:20px;

    font-size:28px;
}

.lesson-btn{

    width:100%;

    padding:14px;

    border:none;

    border-radius:15px;

    background:#00b894;

    color:white;

    font-size:20px;

    cursor:pointer;

    transition:.3s;
}

.lesson-btn:hover{

    background:#00a383;
}

.quiz-menu-btn{
    width:100%;
    margin-top:10px;
    padding:12px 14px;
    border:2px solid #ffb703;
    border-radius:15px;
    background:#fff8dc;
    color:#a26400;
    font-size:18px;
    font-weight:700;
    cursor:pointer;
    transition:.3s;
}

.quiz-menu-btn:not(:disabled):hover{
    background:#ffb703;
    color:#fff;
    transform:translateY(-2px);
}

.quiz-menu-btn:disabled{
    border-color:#d7dce5;
    background:#f1f3f5;
    color:#8b98a9;
    cursor:not-allowed;
}

.quiz-menu-btn.is-unlocked{
    box-shadow:0 8px 16px rgba(255,183,3,.2);
}

/* =====================================================
   BACK BUTTON
===================================================== */

.back-btn{

    margin-top:40px;

    padding:16px 35px;

    border:none;

    border-radius:18px;

    background:#6c5ce7;

    color:white;

    cursor:pointer;

    font-size:20px;

    transition:.3s;
}

.remove-btn{

    padding:10px 18px;

    border:none;

    border-radius:14px;

    background:#e63946;

    color:white;

    font-size:14px;

    cursor:pointer;

    transition:.2s;

}

.remove-btn:hover{

    background:#c92a2a;

}

.back-btn:hover{

    background:#5845d4;
}

#teacherLogoutBtn{
    background:#e63946;
}

#teacherLogoutBtn:hover{
    background:#c6283d;
}

/* =====================================================
   SETTINGS MODAL
===================================================== */

.modal{

    display:none;

    position:fixed;

    top:0;
    left:0;

    width:100%;
    height:100%;

    background:rgba(29,53,87,.48);

    justify-content:center;

    align-items:center;

    z-index:999;

    padding:20px;

    backdrop-filter:blur(6px);
}

.modal-content{

    width:420px;

    background:white;

    border-radius:25px;

    padding:35px;

    position:relative;

    animation:popup .35s ease;
}

.settings-panel{
    width:min(460px,100%);
    max-height:min(90vh,760px);
    overflow:auto;
    padding:0;
    border-radius:28px;
    background:
        linear-gradient(180deg,rgba(255,255,255,.96),rgba(255,255,255,.92)),
        linear-gradient(145deg,#dff4ff 0%,#fff7cb 55%,#ffe4b8 100%);
    box-shadow:
        0 28px 60px rgba(29,53,87,.22),
        0 0 0 1px rgba(255,255,255,.55) inset;
    animation:settingsPop .42s cubic-bezier(.2,.9,.25,1);
}

@keyframes settingsPop{
    from{
        opacity:0;
        transform:translateY(18px) scale(.94);
    }
    to{
        opacity:1;
        transform:translateY(0) scale(1);
    }
}

.settings-close{
    position:absolute;
    top:16px;
    right:16px;
    width:42px;
    height:42px;
    border:none;
    border-radius:14px;
    background:rgba(255,255,255,.75);
    color:#5a6a7f;
    font-size:20px;
    cursor:pointer;
    display:grid;
    place-items:center;
    transition:transform .2s ease, background .2s ease, color .2s ease;
    z-index:2;
}

.settings-close:hover{
    background:#fff;
    color:#e63946;
    transform:rotate(90deg);
}

.settings-header{
    display:flex;
    align-items:center;
    gap:16px;
    padding:28px 28px 18px;
}

.settings-header-icon{
    width:58px;
    height:58px;
    flex-shrink:0;
    border-radius:18px;
    display:grid;
    place-items:center;
    font-size:24px;
    color:#fff;
    background:linear-gradient(145deg,#ff8a4c,#ff6b6b);
    box-shadow:0 10px 22px rgba(255,107,107,.35);
}

.settings-panel .settings-header-text h2{
    text-align:left;
    color:#1d3557;
    margin:0 0 4px;
    font-size:30px;
}

.settings-header-text p{
    margin:0;
    color:#5f6f84;
    font-size:15px;
    line-height:1.35;
    max-width:28ch;
}

.settings-body{
    display:flex;
    flex-direction:column;
    gap:14px;
    padding:0 22px 8px;
}

.settings-section{
    background:rgba(255,255,255,.72);
    border:1px solid rgba(61,123,198,.12);
    border-radius:22px;
    padding:14px 14px 8px;
}

.settings-section-title{
    display:flex;
    align-items:center;
    gap:10px;
    margin:0 0 8px;
    padding:4px 6px 10px;
    font-size:15px;
    letter-spacing:.04em;
    text-transform:uppercase;
    color:#3a86ff;
    border-bottom:1px solid rgba(58,134,255,.14);
}

.settings-section-title i{
    width:28px;
    height:28px;
    border-radius:10px;
    display:grid;
    place-items:center;
    background:rgba(58,134,255,.12);
    font-size:13px;
}

.setting-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
    padding:12px 8px;
    border-radius:16px;
    transition:background .2s ease;
}

.setting-row:hover{
    background:rgba(141,211,255,.14);
}

.setting-row--stack{
    flex-direction:column;
    align-items:stretch;
    gap:10px;
}

.setting-copy{
    display:flex;
    flex-direction:column;
    gap:2px;
    min-width:0;
}

.setting-copy--inline{
    flex-direction:row;
    justify-content:space-between;
    align-items:baseline;
    width:100%;
}

.setting-label{
    font-size:18px;
    font-weight:600;
    color:#1d3557;
}

.setting-hint{
    font-size:13px;
    color:#6b7c90;
    line-height:1.3;
}

.setting-value{
    font-size:15px;
    font-weight:700;
    color:#ff8a4c;
    min-width:3.2em;
    text-align:right;
}

/* Toggle switch */
.switch{
    position:relative;
    display:inline-flex;
    width:56px;
    height:32px;
    flex-shrink:0;
    cursor:pointer;
}

.switch input{
    opacity:0;
    width:0;
    height:0;
    position:absolute;
}

.switch-track{
    position:absolute;
    inset:0;
    border-radius:999px;
    background:#cfd8e3;
    transition:background .25s ease, box-shadow .25s ease;
    box-shadow:inset 0 1px 3px rgba(0,0,0,.12);
}

.switch-track::after{
    content:"";
    position:absolute;
    top:3px;
    left:3px;
    width:26px;
    height:26px;
    border-radius:50%;
    background:#fff;
    box-shadow:0 3px 8px rgba(29,53,87,.2);
    transition:transform .25s cubic-bezier(.2,.9,.25,1);
}

.switch input:checked + .switch-track{
    background:linear-gradient(135deg,#57cc99,#38b000);
}

.switch input:focus-visible + .switch-track{
    outline:3px solid rgba(58,134,255,.45);
    outline-offset:2px;
}

.switch input:checked + .switch-track::after{
    transform:translateX(24px);
}

/* Range slider */
.setting-range{
    -webkit-appearance:none;
    appearance:none;
    width:100%;
    height:10px;
    border-radius:999px;
    background:linear-gradient(90deg,#8fd3ff,#ffb703);
    outline:none;
    cursor:pointer;
}

.setting-range::-webkit-slider-thumb{
    -webkit-appearance:none;
    appearance:none;
    width:24px;
    height:24px;
    border-radius:50%;
    border:3px solid #fff;
    background:linear-gradient(145deg,#ffb703,#ff8a4c);
    box-shadow:0 4px 12px rgba(255,138,76,.4);
    cursor:pointer;
    transition:transform .15s ease;
}

.setting-range::-moz-range-thumb{
    width:24px;
    height:24px;
    border-radius:50%;
    border:3px solid #fff;
    background:linear-gradient(145deg,#ffb703,#ff8a4c);
    box-shadow:0 4px 12px rgba(255,138,76,.4);
    cursor:pointer;
}

.setting-range:active::-webkit-slider-thumb{
    transform:scale(1.12);
}

.settings-footer{
    padding:10px 22px 24px;
}

.settings-done-btn{
    width:100%;
    border:none;
    border-radius:16px;
    padding:15px 18px;
    font-family:inherit;
    font-size:18px;
    font-weight:700;
    color:#fff;
    cursor:pointer;
    background:linear-gradient(135deg,#ffb703,#ff8a4c);
    box-shadow:0 10px 22px rgba(255,183,3,.35);
    transition:transform .2s ease, box-shadow .2s ease, filter .2s ease;
}

.settings-done-btn:hover{
    transform:translateY(-2px);
    filter:brightness(1.03);
    box-shadow:0 14px 26px rgba(255,183,3,.42);
}

.settings-done-btn:active{
    transform:translateY(0);
}

/* Language modal button spacing */
.language-options{
    display:flex;
    justify-content:center;
    gap:14px;
    margin-top:12px;
}

.language-cancel{
    display:flex;
    justify-content:center;
    margin-top:12px;
}

@keyframes popup{

    from{

        transform:scale(.6);

        opacity:0;
    }

    to{

        transform:scale(1);

        opacity:1;
    }
}

.close{

    position:absolute;

    top:15px;

    right:20px;

    font-size:32px;

    cursor:pointer;

    color:#888;
}

.close:hover{

    color:red;
}

.modal-content h2{

    text-align:center;

    color:#ff6b6b;

    margin-bottom:25px;
}

.setting-item{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin:18px 0;

    font-size:20px;
}

/* =====================================================
   FOOTER
===================================================== */

footer{

    text-align:center;

    padding:20px;

    color:#555;

    font-size:17px;
}

/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:768px){

    h1{

        font-size:40px;

    }


    .subtitle{

        font-size:18px;
    }

    .mascot{

        width:180px;
    }

    .main-btn{

        font-size:18px;
    }

    .lesson-grid{

        grid-template-columns:1fr;
    }

    .profile-container{

        padding:25px;
    }

    .menu-container h2{

        font-size:30px;
    }

    .modal-content{

        width:92%;
    }

    .settings-panel{
        width:100%;
        max-height:88vh;
    }

    .settings-header{
        padding:24px 22px 14px;
        gap:12px;
    }

    .settings-header-text h2{
        font-size:26px;
    }

    .settings-header-text p{
        font-size:14px;
    }

    .setting-label{
        font-size:16px;
    }

}


/* =====================================================
   LESSON SCREEN
===================================================== */

.lesson-container{

    width:100%;
    max-width:1100px;
    max-height:calc(100vh - 24px);
    overflow:hidden;

    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    background:#ffffff;

    border-radius:34px;

    padding:22px 40px 20px;

    text-align:center;

    box-shadow:0 20px 45px rgba(0,0,0,.15);

}

/* =====================================================
   PROGRESS BAR
===================================================== */

.lesson-progress{

    width:100%;
    height:16px;

    background:#e8f4ff;

    border-radius:30px;

    overflow:hidden;

    margin-bottom:12px;

    flex-shrink:0;

}

.progress-fill{

    width:0%;

    height:100%;

    background:linear-gradient(90deg,#00d2ff,#00c853);

    border-radius:30px;

    transition:.4s;

}

/* =====================================================
   LESSON TITLE
===================================================== */

#lessonTitle{

    font-size:clamp(28px, 4.2vh, 44px);

    color:#ff6b6b;

    margin-bottom:10px;

    line-height:1.15;

    flex-shrink:0;

}

/* =====================================================
   LESSON IMAGE
===================================================== */

.lesson-image{

    width:min(220px, 26vh);

    height:min(220px, 26vh);

    margin:0 auto;

    display:flex;

    justify-content:center;

    align-items:center;

    background:#f5fbff;

    border-radius:28px;

    box-shadow:0 8px 20px rgba(0,0,0,.10);

    flex-shrink:0;

}

.lesson-image img{

    max-width:78%;

    max-height:78%;

    object-fit:contain;

}

/* =====================================================
   LETTER
===================================================== */

#lessonLetter{

    font-size:clamp(52px, 8.5vh, 84px);

    color:#3a86ff;

    margin-top:8px;

    line-height:1.05;

    flex-shrink:0;

}

#lessonLetter.lesson-prompt-text{
    font-size:clamp(22px, 3.2vh, 32px);
    line-height:1.3;
    max-width:860px;
    margin-left:auto;
    margin-right:auto;
    padding:0 12px;
    text-align:center;
}

/* =====================================================
   WORD
===================================================== */

#lessonWord{

    font-size:clamp(24px, 3.6vh, 36px);

    color:#444;

    margin:4px 0 8px;

    line-height:1.2;

    flex-shrink:0;

}

#lessonWord[hidden]{
    display:none !important;
}

/* =====================================================
   VOICE BUTTON
===================================================== */

.voice-btn{

    padding:12px 28px;

    border:none;

    border-radius:50px;

    background:#ffb703;

    color:white;

    font-size:clamp(16px, 2.4vh, 20px);

    font-weight:bold;

    cursor:pointer;

    transition:.3s;

    margin-bottom:0;

}

.lesson-voice-actions{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:6px;
    flex-wrap:wrap;
    margin-bottom:4px;
    flex-shrink:0;
}

.voice-btn--speak{
    background:#3a86ff;
}

.voice-btn--speak:hover{
    background:#2667d1;
}

.voice-btn--speak.is-listening{
    background:#e63946;
    animation:micPulse 1s ease-in-out infinite;
}

@keyframes micPulse{
    0%,100%{ transform:scale(1); box-shadow:0 0 0 0 rgba(230,57,70,.45); }
    50%{ transform:scale(1.05); box-shadow:0 0 0 12px rgba(230,57,70,0); }
}

.lesson-voice-status{
    min-height:22px;
    margin:0 0 4px;
    font-size:clamp(16px, 2.4vh, 20px);
    font-weight:700;
    color:#1d3557;
    flex-shrink:0;
}

.lesson-voice-status.is-correct{
    color:#2a9d8f;
}

.lesson-voice-status.is-wrong{
    color:#e76f51;
}

.lesson-voice-status.is-listening{
    color:#e63946;
}

.voice-btn:hover{

    background:#fb8500;

    transform:scale(1.08);

}

.voice-btn:active{

    transform:scale(.95);

}

/* =====================================================
   NAVIGATION
===================================================== */

.lesson-navigation{

    display:flex;

    justify-content:center;

    gap:6px;

    margin-bottom:4px;

    flex-shrink:0;

}

.lesson-nav-btn{

    min-width:150px;

    padding:12px 18px;

    border:none;

    border-radius:18px;

    background:#6c5ce7;

    color:white;

    font-size:clamp(16px, 2.4vh, 20px);

    cursor:pointer;

    transition:.3s;

}

.lesson-nav-btn:hover{

    background:#5a4bd1;

    transform:translateY(-4px);

}

/* =====================================================
   LESSON HOME BUTTON
===================================================== */

#lessonHomeBtn{

    background:#00b894;
    margin-top:4px;
    width:min(100%, 280px);
    max-width:100%;
    box-sizing:border-box;
    padding:12px 18px;
    font-size:clamp(15px, 2.2vh, 18px);
    white-space:nowrap;
    flex-shrink:0;

}

#lessonHomeBtn:hover{

    background:#00a383;

}

/* =====================================================
   LESSON ANIMATIONS
===================================================== */

.lesson-image{

    animation:floatImage 2.5s ease-in-out infinite;

}

@keyframes floatImage{

    0%{

        transform:translateY(0px);

    }

    50%{

        transform:translateY(-10px);

    }

    100%{

        transform:translateY(0px);

    }

}

#lessonLetter{

    animation:fadeLetter .8s;

}

@keyframes fadeLetter{

    from{

        opacity:0;

        transform:scale(.5);

    }

    to{

        opacity:1;

        transform:scale(1);

    }

}

/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:768px){

    .lesson-container{

        padding:16px 16px 14px;
        max-height:calc(100vh - 16px);
        overflow-y:auto;

    }

    #lessonTitle{

        font-size:clamp(24px, 4vh, 34px);

    }

    .lesson-image{

        width:min(180px, 24vh);

        height:min(180px, 24vh);

    }

    #lessonLetter{

        font-size:clamp(44px, 7.5vh, 68px);

    }

    #lessonLetter.lesson-prompt-text{
        font-size:clamp(18px, 2.8vh, 24px);
    }

    #lessonWord{

        font-size:clamp(20px, 3.2vh, 28px);

    }

    .lesson-navigation{

        flex-direction:row;
        flex-wrap:wrap;
        width:100%;
        gap:6px;
        margin-bottom:2px;

    }

    .lesson-nav-btn{

        flex:1 1 120px;
        min-width:0;
        font-size:16px;
        padding:10px 12px;

    }

    .voice-btn{

        font-size:16px;
        padding:10px 20px;

    }

    .lesson-voice-actions{
        flex-direction:row;
        flex-wrap:wrap;
        width:100%;
    }

    .lesson-voice-status{
        font-size:16px;
        min-height:18px;
    }

}


/* =====================================================
   QUIZ SCREEN
===================================================== */

.quiz-container{

    width:100%;
    max-width:1240px;

    background:#ffffff;

    border-radius:34px;

    padding:36px 52px;

    text-align:center;

    box-shadow:0 20px 45px rgba(0,0,0,.15);

    overflow:visible;

    max-height:none;

    position:relative;

}

/* =====================================================
   QUIZ STAR SCORE
===================================================== */

.quiz-star-score{
    position:fixed;
    top:24px;
    left:24px;
    right:auto;
    z-index:1200;
    display:none;
    align-items:center;
    gap:8px;
    min-width:118px;
    padding:12px 16px;
    border-radius:18px;
    background:linear-gradient(145deg,#fff6d6,#ffe08a);
    border:2px solid rgba(255,183,3,.55);
    box-shadow:0 10px 24px rgba(255,183,3,.28);
    transform-origin:center;
    transition:transform .2s ease, box-shadow .2s ease;
}

.quiz-star-score.is-visible{
    display:flex;
}

.floating-settings-btn{
    position:fixed;
    top:24px;
    right:24px;
    z-index:1200;
    width:56px;
    height:56px;
    border:none;
    border-radius:18px;
    display:none;
    place-items:center;
    cursor:pointer;
    color:#fff;
    font-size:24px;
    background:linear-gradient(145deg,#ffb703,#ff8a4c);
    box-shadow:0 10px 24px rgba(255,183,3,.35);
    transition:transform .2s ease, box-shadow .2s ease, filter .2s ease;
}

.floating-settings-btn.is-visible{
    display:grid;
}

.floating-settings-btn:hover{
    transform:translateY(-2px) rotate(25deg) scale(1.05);
    box-shadow:0 14px 28px rgba(255,138,76,.42);
    filter:brightness(1.05);
}

.floating-settings-btn:active{
    transform:scale(0.96);
}

.quiz-star-score:hover{
    transform:translateY(-2px) scale(1.03);
    box-shadow:0 14px 28px rgba(255,183,3,.38);
}

.quiz-star-icon{
    font-size:34px;
    line-height:1;
    color:#ffb703;
    text-shadow:0 2px 0 rgba(255,140,0,.25);
    animation:starIdle 2.4s ease-in-out infinite;
}

.quiz-star-count{
    font-size:30px;
    font-weight:700;
    color:#c77700;
    line-height:1;
    min-width:1.2em;
}

.quiz-star-label{
    font-size:13px;
    font-weight:600;
    letter-spacing:.04em;
    text-transform:uppercase;
    color:#a86b00;
}

.quiz-star-score.pop{
    animation:starScorePop .55s cubic-bezier(.2,.9,.25,1);
}

.quiz-star-score.pop .quiz-star-icon{
    animation:starBurst .55s ease;
}

.quiz-star-score.pop .quiz-star-count{
    animation:starCountBump .55s ease;
}

.quiz-star-score.star-celebration{
    box-shadow:0 0 0 5px rgba(255,214,10,.16),0 16px 36px rgba(255,183,3,.48);
}

.star-reward-flight{
    position:fixed;
    top:50%;
    left:50%;
    z-index:2500;
    display:flex;
    align-items:center;
    gap:12px;
    padding:18px 26px;
    border:3px solid #ffb703;
    border-radius:24px;
    background:linear-gradient(145deg,#fffdf0,#ffe08a);
    color:#a85f00;
    font-size:34px;
    line-height:1;
    box-shadow:0 16px 38px rgba(255,183,3,.45),0 0 0 8px rgba(255,214,10,.18);
    pointer-events:none;
    transform:translate(-50%,-50%) scale(1);
    animation:starRewardAppear .5s cubic-bezier(.2,.9,.25,1) both;
}

.star-reward-flight.is-flying{
    animation:starRewardFly .75s cubic-bezier(.55,.05,.2,1) forwards;
}

.star-reward-icon{
    color:#ffb703;
    font-size:58px;
    text-shadow:0 3px 0 #e58b00,0 0 16px rgba(255,183,3,.7);
    animation:starRewardIcon .5s ease-in-out infinite alternate;
}

.star-reward-flight strong{
    font-size:42px;
}

.quiz-star-float{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%, -50%);
    font-size:22px;
    font-weight:700;
    color:#ff8a00;
    pointer-events:none;
    opacity:0;
    z-index:6;
    text-shadow:0 2px 8px rgba(255,183,3,.45);
    animation:starFloatUp .9s ease forwards;
}

.quiz-star-spark{
    position:absolute;
    top:50%;
    left:50%;
    width:7px;
    height:16px;
    border-radius:999px;
    background:#ffb703;
    box-shadow:0 0 10px rgba(255,183,3,.8);
    pointer-events:none;
    transform:rotate(var(--spark-angle)) translateY(-8px) scale(.2);
    animation:starSpark .65s cubic-bezier(.2,.8,.3,1) forwards;
}

.quiz-star-ring{
    position:absolute;
    top:50%;
    left:50%;
    width:100%;
    aspect-ratio:1;
    border:3px solid rgba(255,183,3,.72);
    border-radius:50%;
    pointer-events:none;
    transform:translate(-50%,-50%) scale(.4);
    animation:starRing .7s ease-out forwards;
}

.quiz-star-ray{
    position:absolute;
    top:50%;
    left:50%;
    width:5px;
    height:13px;
    border-radius:999px;
    background:#ff8a4c;
    pointer-events:none;
    transform:rotate(var(--ray-angle)) translateY(-24px) scaleY(.2);
    transform-origin:50% 24px;
    animation:starRay .7s cubic-bezier(.2,.8,.3,1) forwards;
}

@keyframes starIdle{
    0%,100%{ transform:rotate(-6deg) scale(1); }
    50%{ transform:rotate(6deg) scale(1.08); }
}

@keyframes starScorePop{
    0%{ transform:scale(1); }
    35%{ transform:scale(1.18) rotate(-2deg); }
    70%{ transform:scale(0.96) rotate(2deg); }
    100%{ transform:scale(1) rotate(0deg); }
}

@keyframes starBurst{
    0%{ transform:scale(1) rotate(0deg); filter:brightness(1); }
    40%{ transform:scale(1.45) rotate(-18deg); filter:brightness(1.25); }
    100%{ transform:scale(1) rotate(0deg); filter:brightness(1); }
}

@keyframes starCountBump{
    0%{ transform:scale(1); }
    40%{ transform:scale(1.35); color:#ff6b00; }
    100%{ transform:scale(1); }
}

@keyframes starFloatUp{
    0%{
        opacity:0;
        transform:translate(-50%, 8px) scale(.8);
    }
    20%{
        opacity:1;
        transform:translate(-50%, -10px) scale(1.15);
    }
    100%{
        opacity:0;
        transform:translate(-50%, -48px) scale(1);
    }
}

@keyframes starRewardAppear{
    0%{ opacity:0; transform:translate(-50%,-50%) scale(.35); }
    70%{ opacity:1; transform:translate(-50%,-50%) scale(1.12); }
    100%{ opacity:1; transform:translate(-50%,-50%) scale(1); }
}

@keyframes starRewardIcon{
    from{ transform:rotate(-10deg) scale(1); }
    to{ transform:rotate(10deg) scale(1.12); }
}

@keyframes starRewardFly{
    0%{ opacity:1; transform:translate(-50%,-50%) scale(1) rotate(0deg); }
    65%{ opacity:1; transform:translate(calc(-50% + var(--fly-x) * .72),calc(-50% + var(--fly-y) * .72)) scale(.7) rotate(250deg); }
    100%{ opacity:0; transform:translate(calc(-50% + var(--fly-x)),calc(-50% + var(--fly-y))) scale(.22) rotate(360deg); }
}

@keyframes starSpark{
    0%{ opacity:0; transform:rotate(var(--spark-angle)) translateY(-8px) scale(.2); }
    25%{ opacity:1; }
    100%{ opacity:0; transform:rotate(var(--spark-angle)) translateY(calc(var(--spark-distance) * -1)) scale(1); }
}

@keyframes starRing{
    0%{ opacity:.9; transform:translate(-50%,-50%) scale(.35); }
    100%{ opacity:0; transform:translate(-50%,-50%) scale(2.1); }
}

@keyframes starRay{
    0%{ opacity:0; transform:rotate(var(--ray-angle)) translateY(-22px) scaleY(.2); }
    25%{ opacity:1; }
    100%{ opacity:0; transform:rotate(var(--ray-angle)) translateY(-50px) scaleY(1); }
}

