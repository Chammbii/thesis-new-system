===================================================== */

.answer-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:16px;
    margin-top:22px;
    justify-items:center;
}

/* Difficulty-based layouts */
#quizAnswerGrid[data-quiz-choice-layout="easy"]{
    /* 3 choices => 1 row x 3 columns */
    grid-template-columns:repeat(3,minmax(0,1fr));
}

#quizAnswerGrid[data-quiz-choice-layout="medium"]{
    /* 6 choices => 2 rows x 3 columns */
    grid-template-columns:repeat(3,minmax(0,1fr));
}

#quizAnswerGrid[data-quiz-choice-layout="hard"]{
    /* 10 choices => 2 rows x 5 columns */
    grid-template-columns:repeat(5,minmax(0,1fr));
}

/* Hide unused choice slots so only the active count shows */
.answer-card.unused,
.answer-card[hidden]{
    display:none !important;
}

